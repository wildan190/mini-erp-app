APP_NAME=Mini-ERP
APP_ENV=local
APP_KEY=base64:6VkI4ImSRV15ulINeR0E7PrNw3Ban7YjB9J10X0sG04=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=db-mini-erp
DB_USERNAME=postgres
DB_PASSWORD=manchester

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

OCTANE_SERVER=swoole
# Workers per container — 2 HTTP workers + 1 task worker keeps RAM under ~200MB per service.
# Bump to 4/2 on a machine with more headroom.
OCTANE_WORKERS=2
OCTANE_TASK_WORKERS=1
# Recycle each worker after 500 requests to prevent slow memory creep
OCTANE_MAX_REQUESTS=500
# Log a warning when worker RAM exceeds this value (MB)
OCTANE_MEMORY_WARN_MB=100

# -------------------------------------------------------------------------
# Laravel Passport
# -------------------------------------------------------------------------
# Option A (recommended for production): paste your RSA keys inline below.
# Generate them once with: php artisan passport:keys
# then copy the contents of storage/oauth-private.key and storage/oauth-public.key.
#
# PASSPORT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# <your key here>
# -----END RSA PRIVATE KEY-----"
#
# PASSPORT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# <your key here>
# -----END PUBLIC KEY-----"
#
# Option B (default for local dev): leave both vars empty / commented out.
# The entrypoint will run `passport:keys` and store the files under storage/app/.
